# Copy to .env and fill in real values. NEVER commit the real .env.
# Values come from your Proton VPN WireGuard .conf file.
VPN_PRIVATE_KEY=your_wireguard_private_key
VPN_ADDRESSES=10.2.0.2/32
VPN_PUBLIC_KEY=your_proton_peer_public_key
WIREGUARD_ENDPOINT_IP=your_proton_server_ip
WIREGUARD_ENDPOINT_PORT=51820
QBITTORRENT_PASSWORD=change_me